                            variant="ghost"
                            className="w-full border border-dashed border-zinc-700 text-zinc-500 hover:border-yellow-500 hover:text-yellow-400 hover:bg-yellow-500/5"
                            onClick={onSelectWinner}
                        >
                            <Gavel className="h-4 w-4 mr-2" />
                            {buttonLabel}
