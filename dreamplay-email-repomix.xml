    is_starred_template?: boolean
    email_type?: string
    sent_from_email?: string | null
    sent_to_emails?: string[]
    parent_template_id?: string | null
    scheduled_at?: string | null
    scheduled_status?: string | null
    recipient_breakdown?: {
        subscriber_id: string
        email: string
