                                        <><UserPlus className="h-4 w-4" /> Enroll {selectedSubIds.length} Subscriber{selectedSubIds.length !== 1 ? "s" : ""}</>
                                    )}
                                </Button>
                            </div>
                        </>
                    )}
                </div>
            )}
        </div>
    )
}
