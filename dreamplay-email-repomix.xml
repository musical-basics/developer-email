                                        }}
                                    >
                                        <Eye className="h-3 w-3" />
                                        {view.name}
                                        {activeViewId === view.id && (
                                            <X className="h-3 w-3 ml-0.5 opacity-70 hover:opacity-100" onClick={(e) => {
                                                e.stopPropagation()
                                                clearActiveView()
                                            }} />
                                        )}
                                    </Button>
                                </ContextMenuTrigger>
                                <ContextMenuContent className="w-48">
                                    <ContextMenuItem
                                        onClick={() => {
                                            setRenamingViewId(view.id)
                                            setRenameViewName(view.name)
