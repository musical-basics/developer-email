                                    key={`folder-${folder.name}`}
                                    onClick={() => navigateToFolder(folder.name)}
                                    onDragOver={(e) => handleFolderDragOver(e, folder.name)}
                                    onDragLeave={handleFolderDragLeave}
                                    onDrop={(e) => handleFolderDrop(e, folder.name)}
                                    className={cn(
