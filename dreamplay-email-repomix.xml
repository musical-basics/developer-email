                                {part}
                            </button>
                        </div>
                    ))}
                </div>
            )}

            <Card>
                <CardHeader>
                    <div className="flex items-center justify-between">
                        <div>
                            <CardTitle>Your Assets</CardTitle>
                            <CardDescription>
                                {folders.length > 0 && `${folders.length} folder${folders.length !== 1 ? "s" : ""}, `}
                                {assets.length} asset{assets.length !== 1 ? "s" : ""}
